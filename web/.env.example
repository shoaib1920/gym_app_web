# Firebase web app config (Firebase Console > Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Sign-In web OAuth client ID (Google Cloud Console > APIs & Services >
# Credentials). Leave blank to skip Google sign-in.
VITE_GOOGLE_WEB_CLIENT_ID=

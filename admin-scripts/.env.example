# Firebase Admin SDK service account — Firebase Console > Project Settings >
# Service Accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: absolute path to the service account JSON file instead of inline JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional — only needed to let setup-firebase.ts enable "Continue with
# Google" for you. From Google Cloud Console > APIs & Services > Credentials
# > OAuth 2.0 Client IDs (Web application).
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=

# Gmail SMTP — used by the fee-renewal reminder script. GMAIL_APP_PASSWORD
# is a 16-char App Password (Google Account > Security > App Passwords),
# not your normal Gmail login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
